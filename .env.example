# ── Database ──
DATABASE_URL="postgresql://dlqhealer:dlqhealer@localhost:5432/dlqhealer?schema=public"

# ── Redis ──
REDIS_URL="redis://localhost:6379"

# ── Engine ──
ENGINE_PORT=5000
ENGINE_API_KEY="dlq_dev_secret_key"
INTAKE_QUEUE_NAME="dlq-healer-intake"
MAX_REPLAY_ATTEMPTS=1
# Optional 32-byte (64-hex or base64) key for AES-256-GCM sealed replay envelopes (required for fail-closed redacted payload replay in production):
# DLQ_PAYLOAD_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# ── Dashboard ──
DASHBOARD_URL="http://localhost:3000"
ENGINE_URL="http://localhost:5000"
NEXT_PUBLIC_ENGINE_URL="http://localhost:5000"
# Optional operator session auth (leave commented for default local dev/demo access):
# DASHBOARD_OPERATOR_PASSWORD="replace-with-a-strong-operator-password"
# DASHBOARD_SESSION_SECRET="replace-with-at-least-32-random-characters-for-session-signing"
# Set DASHBOARD_COOKIE_SECURE="true" when terminating HTTPS in production (defaults to true when NODE_ENV=production unless overridden):
# DASHBOARD_COOKIE_SECURE="false"

# ── AI / LLM ("gemini" | "mock") ──
LLM_PROVIDER="gemini"
LLM_API_KEY="your-llm-api-key-here"

# ── Embedding ("gemini" | "mock") ──
EMBEDDING_PROVIDER="gemini"
EMBEDDING_API_KEY="your-embedding-api-key-here"
